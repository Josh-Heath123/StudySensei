# Optional. By default the app calls the API at /api on its own origin, and the
# Vite dev server proxies /api/* to http://localhost:8000 (no CORS in development).
#
# Call an API directly instead (it must allow this origin in CORS_ORIGINS):
# VITE_API_URL=http://localhost:8000
#
# Point the dev proxy somewhere else (read by vite.config.ts, not the browser):
# API_PROXY_TARGET=http://localhost:8001
