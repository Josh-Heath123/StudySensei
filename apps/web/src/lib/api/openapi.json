          "semester": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Semester"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "ModuleCreate"
      },
