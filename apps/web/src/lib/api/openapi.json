            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "colour": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Colour",
            "default": "#007AFF"
