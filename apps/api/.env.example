# Copy to apps/api/.env. Every value has a working default for local dev.

# docker-compose Postgres (host port 5433)
DATABASE_URL=postgresql+asyncpg://studysensei:studysensei@localhost:5433/studysensei

# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# Uploaded materials (default: <repo>/data/materials) and the upload size limit in bytes
# STORAGE_DIR=../../data/materials
# MAX_UPLOAD_BYTES=52428800

# Where the local embedding model (bge-small-en-v1.5) is cached; the first run downloads it
# MODELS_DIR=../../data/models

# --- AI providers (decision 0002). A provider without a key is skipped; with none, AI features say so. ---
# Free-tier keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Check them with: uv run python -m app.ai.ping
GEMINI_API_KEY=
GROQ_API_KEY=
# Local Ollama is off unless a model is named (it's then tried last in every role), e.g. llama3.2
# OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Roles: ordered JSON lists of routes. reasoning_effort is minimal, low, medium or high, or "" to
# not send it (the model's default). A plain "provider/model" string means "".
# It goes only to models in AI_REASONING_EFFORTS, raised to the model's lowest supported level
# when it lacks the one asked for (gemini-3.8-flash has no "minimal", so it gets "low").
# Defaults:
# AI_SMART=[{"route":"groq/openai/gpt-oss-120b","reasoning_effort":"low"},{"route":"gemini/gemini-3.5-flash-lite","reasoning_effort":"low"},{"route":"gemini/gemini-3.8-flash","reasoning_effort":"low"}]
# AI_BULK=[{"route":"gemini/gemini-3.5-flash-lite","reasoning_effort":"minimal"},{"route":"groq/openai/gpt-oss-20b","reasoning_effort":"low"}]
# Any request with an image uses this role instead (every model in it must accept images; no Ollama):
# AI_VISION=[{"route":"gemini/gemini-3.5-flash-lite","reasoning_effort":"low"},{"route":"groq/qwen/qwen3.8-27b","reasoning_effort":"low"},{"route":"gemini/gemini-3.8-flash","reasoning_effort":"low"}]
# Whole documents in one prompt (topic maps). Groq is last: its 200K tokens a day is a few decks.
# AI_LONG=[{"route":"gemini/gemini-3.5-flash-lite","reasoning_effort":"low"},{"route":"gemini/gemini-3.8-flash","reasoning_effort":"low"},{"route":"groq/openai/gpt-oss-120b","reasoning_effort":"low"}]

# Topic maps (decision 0006): text sent per material, and the chunk-link similarity cut-off
# TOPIC_MAX_CHARS=400000
# TOPIC_LINK_THRESHOLD=0.63
# TOPIC_LINK_MAX_CHUNKS=12
# Pages with less text than this never link by similarity (title slides, dividers); cited pages still do
# TOPIC_LINK_MIN_PAGE_CHARS=150
# Long materials go in parts of about this many pages; at most this many AI calls per material per run
# TOPIC_PART_PAGES=40
# TOPIC_MAX_CALLS=4
# Requests turned away before running (429, 503 busy) per material per run; they don't use TOPIC_MAX_CALLS
# TOPIC_MAX_TURNED_AWAY=20
# The merge request's size in estimated tokens; descriptions are added only while it fits (Groq: 8K a minute)
# TOPIC_MERGE_MAX_TOKENS=7000
# Requests per day per model (free tier less ~10 %), models that read images, and quota reset zones:
# AI_DAILY_BUDGET={"gemini/gemini-3.8-flash":18,"gemini/gemini-3.5-flash-lite":450,"groq/openai/gpt-oss-120b":900,"groq/openai/gpt-oss-20b":900,"groq/qwen/qwen3.8-27b":900}
# AI_REASONING_EFFORTS={"gemini/gemini-3.8-flash":["low","medium","high"],"gemini/gemini-3.5-flash-lite":["minimal","low","medium","high"],"groq/openai/gpt-oss-120b":["low","medium","high"],"groq/openai/gpt-oss-20b":["low","medium","high"],"groq/qwen/qwen3.8-27b":["low","medium","high"]}
# AI_QUOTA_TIMEZONE={"gemini":"America/Los_Angeles","groq":"UTC"}
# Requests per minute per model (free-tier RPM less a margin); requests wait their turn
# AI_REQUESTS_PER_MINUTE={"gemini/gemini-3.8-flash":4,"gemini/gemini-3.5-flash-lite":12,"groq/openai/gpt-oss-120b":25,"groq/openai/gpt-oss-20b":25,"groq/qwen/qwen3.8-27b":25}
# Seconds to connect, and to wait for a reply (thinking models can be slow)
# AI_CONNECT_TIMEOUT_SECONDS=10
# AI_READ_TIMEOUT_SECONDS=90
