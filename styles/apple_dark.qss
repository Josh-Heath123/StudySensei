/* APPLE DARK THEME - MODERN macOS/iOS STYLING */

/* Global Reset - Remove ALL borders and focus outlines */
* {
    border: none;
    outline: none;
}

*:focus {
    outline: none;
}

/* Main Window - Pure Black Background */
QMainWindow {
    background-color: #000000;
    border: none;
}

/* All Widgets - Transparent with White Text */
QWidget {
    background: transparent;
    color: rgba(255, 255, 255, 0.8);
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-size: 13px;
    border: none;
    outline: none;
}

/* Apple-style translucent cards */
QFrame#card, QWidget#card {
    background-color: rgba(28, 28, 30, 0.8);
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 20px;
}

/* Apple buttons */
QPushButton {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 10px 20px;
    color: white;
    font-size: 13px;
    font-weight: 500;
    border: none;
    min-height: 36px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.4);
}

/* Primary action button (blue like iOS) */
QPushButton#primary, QPushButton#start_btn {
    background-color: #007AFF;
    color: white;
    font-weight: 600;
}

QPushButton#primary:hover, QPushButton#start_btn:hover {
    background-color: #0A84FF;
}

QPushButton#primary:pressed, QPushButton#start_btn:pressed {
    background-color: #0051D5;
}

/* Apple-style labels */
QLabel {
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
    font-weight: 400;
    background: transparent;
    border: none;
}

QLabel#title, QLabel[class="header"] {
    color: white;
    font-size: 17px;
    font-weight: 600;
}

QLabel#subtitle, QLabel[class="body"] {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    font-weight: 400;
}

/* Apple-style metrics display */
QLabel#metric {
    color: white;
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -1px;
}

QLabel#metric-label, QLabel[class="metric"] {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Progress bars/circles */
QProgressBar {
    border: none;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    height: 4px;
}

QProgressBar::chunk {
    background-color: #007AFF;
    border-radius: 4px;
}

/* Apple-style inputs */
QLineEdit, QTextEdit {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 10px;
    color: white;
    selection-background-color: #007AFF;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Status Bar - Minimal */
QStatusBar {
    background-color: rgba(28, 28, 30, 0.6);
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    padding: 8px 16px;
}

/* Tab Widget - Minimal Dark */
QTabWidget::pane {
    border: none;
    background-color: transparent;
    padding: 0px;
}

QTabBar::tab {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.6);
    padding: 8px 16px;
    margin-right: 4px;
    border: none;
    font-size: 13px;
    font-weight: 500;
    border-radius: 8px 8px 0px 0px;
}

QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: none;
}

QTabBar::tab:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.9);
}

/* Video Widget - No Border */
VideoWidget {
    border: none;
    background-color: rgba(28, 28, 30, 0.3);
    border-radius: 12px;
}

/* Metrics Panel - Transparent */
MetricsPanel {
    border: none;
    background-color: transparent;
}

/* Focus Circle Widget - Transparent */
FocusCircleWidget {
    border: none;
    background-color: transparent;
}

/* Charts - Dark Theme */
QChartView {
    background-color: rgba(28, 28, 30, 0.4);
    border: none;
    border-radius: 12px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border: none;
    margin: 0px;
    padding: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.3);
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border: none;
    margin: 0px;
    padding: 0px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.3);
}

/* Sidebar styling */
AppleSidebar {
    background-color: rgba(28, 28, 30, 0.95);
    border: none;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QPushButton#sidebar_main_btn,
QPushButton#sidebar_analytics_btn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: left;
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
    font-weight: 500;
}

QPushButton#sidebar_main_btn:hover,
QPushButton#sidebar_analytics_btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
}

QPushButton#sidebar_main_btn:pressed,
QPushButton#sidebar_analytics_btn:pressed {
    background-color: rgba(255, 255, 255, 0.15);
}

/* Toggle button styling */
SidebarToggleButton {
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 20px;
}

SidebarToggleButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

SidebarToggleButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

/* Remove all borders from everything */
QWidget, QFrame, QLabel, QPushButton, QTabWidget, QTabBar, QStatusBar {
    border: none;
}
