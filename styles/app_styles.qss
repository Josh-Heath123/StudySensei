/* StudySensei Application Stylesheet (QSS) - Apple-Inspired Minimalist Design */

/* Global Font - SF Pro (macOS) or Segoe UI (Windows) */
* {
    font-family: "SF Pro Display", "SF Pro Text", "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
}

/* Main Window */
QMainWindow {
    background-color: #ffffff;
}

/* Buttons - NO BORDERS, massive whitespace */
QPushButton {
    border: none;
    border-radius: 12px;
    font-size: 17px;
    font-weight: 400;
    padding: 12px 24px;
    min-height: 45px;
    margin: 0px;
}

QPushButton:hover {
    /* Opacity handled by QGraphicsOpacityEffect in code */
}

QPushButton:pressed {
    /* Opacity handled by QGraphicsOpacityEffect in code */
}

/* Start Button */
QPushButton#start_btn {
    background-color: #007AFF;
    color: white;
}

QPushButton#start_btn:hover {
    background-color: #0051D5;
}

QPushButton#start_btn:pressed {
    background-color: #0040AA;
}

QPushButton#start_btn:disabled {
    background-color: #86868b;
    color: #ffffff;
}

/* Stop Button */
QPushButton#stop_btn {
    background-color: #ffffff;
    color: #1d1d1f;
}

QPushButton#stop_btn:hover {
    background-color: #f5f5f7;
}

QPushButton#stop_btn:disabled {
    background-color: #ffffff;
    color: #86868b;
}

/* Toggle Button */
QPushButton#toggle_mesh_btn {
    background-color: #ffffff;
    color: #1d1d1f;
}

QPushButton#toggle_mesh_btn:hover {
    background-color: #f5f5f7;
}

/* Labels */
QLabel {
    color: #1d1d1f;
    background-color: transparent;
    border: none;
}

/* Status Bar - NO BORDER */
QStatusBar {
    background-color: #ffffff;
    border: none;
    color: #1d1d1f;
    font-size: 13px;
    padding: 12px 24px;
}

/* Tab Widget - NO BORDERS */
QTabWidget::pane {
    border: none;
    background-color: #ffffff;
    padding: 24px;
}

QTabBar::tab {
    background-color: transparent;
    color: #1d1d1f;
    padding: 12px 24px;
    margin-right: 12px;
    border: none;
    font-size: 15px;
    font-weight: 400;
}

QTabBar::tab:selected {
    background-color: transparent;
    color: #007AFF;
    border: none;
}

QTabBar::tab:hover {
    background-color: transparent;
    color: #007AFF;
}

/* Charts */
QChartView {
    background-color: #ffffff;
    border: none;
}

/* Scroll Bars - Minimalist */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    border: none;
    margin: 0px;
    padding: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d2d2d7;
    border-radius: 6px;
    min-height: 20px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: #86868b;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    border: none;
    margin: 0px;
    padding: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d2d2d7;
    border-radius: 6px;
    min-width: 20px;
    margin: 0px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #86868b;
}

/* Video Widget - NO BORDER */
VideoWidget {
    border: none;
    background-color: #ffffff;
}

/* Metrics Panel - NO BORDERS */
MetricsPanel {
    border: none;
    background-color: transparent;
}

/* Focus Circle Widget - NO BORDERS */
FocusCircleWidget {
    border: none;
    background-color: transparent;
}
